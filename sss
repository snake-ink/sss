#!/bin/sh
# sss - vai uma mãozinha?
# https://gitea.abbluiz.com/snake-ink/sss

SELF="$(basename "$0")"
SSS_VERSION="v0.4.0"
# Auto-detecta idioma do sistema se não definido
if [ -z "${SSS_LANG:-}" ]; then
    _sys_lang="${LC_ALL:-${LANG:-}}"
    case "$_sys_lang" in
        pt_*|pt) SSS_LANG="pt" ;;
        *)       SSS_LANG="en" ;;
    esac
fi
SSS_DIR=".sss"
SSS_CONFIG="$SSS_DIR/config.sh"
SSS_MODULES="$SSS_DIR/modules"
SSS_LOCKFILE="$SSS_DIR/modules.lock"
SSS_ENV="${SSS_ENV:-.env}"

_t() {
    key="$1"
    shift
    case "$SSS_LANG" in
        en)
            case "$key" in
                git_not_found) printf '%s: git not found. Install git to continue.\n' "$@" ;;
                initialized) printf '%s: initialized %s/\n' "$@" ;;
                version_mismatch) printf '%s: version "%s" required, running "%s"\n' "$@" ;;
                run_self_update) printf 'Run "%s self-update" to update.\n' "$@" ;;
                usage) printf 'Usage: %s <command> [arguments...]\n\n' "$@" ;;
                internal_cmds) printf 'Internal commands:\n' ;;
                help_desc) printf '  help                  Shows this help\n' ;;
                require_desc) printf '  require <url>[@ref] [as <name>]  Adds a module to the lockfile and installs it\n' ;;
                install_desc) printf '  install               Installs modules from the lockfile\n' ;;
                update_desc) printf '  update [name]         Updates modules with branch constraint\n' ;;
                pin_desc) printf '  pin <version>         Registers the required version in the lockfile\n' ;;
                rebuild_desc) printf '  rebuild <name>         Rebuilds a module by removing and re-installing it\n' ;;
                self_update_desc) printf '  self-update [version] Updates %s itself\n' "$@" ;;
                remove_desc) printf '  remove <name>          Removes a module from the lockfile and uninstalls it\n' ;;
                removed_module) printf '%s: module "%s" removed\n' "$@" ;;
                not_installed) printf '%s: module "%s" is not installed\n' "$@" ;;
                project_cmds) printf 'Project commands:\n' ;;
                modules) printf 'Modules:\n' ;;
                require_usage) printf '%s: require needs a git URL or local path\nUsage: %s require [--local] <url>[@ref] [as <name>] | <path>\n' "$@" ;;
                require_no_arg) printf '%s: require needs a git URL or local path\n' "$@" ;;
                already_installed_same) printf '%s: already installed with the same constraint, nothing to do\n' "$@" ;;
                updating_constraint) printf '%s: updating constraint %s -> %s\n' "$@" ;;
                installing) printf 'Installing %s...\n' "$@" ;;
                install_done) printf 'Done. Run "%s %s" to use it.\n' "$@" ;;
                no_lockfile) printf 'No lockfile found. Use "%s require <url>" to add modules.\n' "$@" ;;
                already_installed_skip) printf '%s: already installed, skipping\n' "$@" ;;
                no_modules_lockfile) printf 'No modules in the lockfile.\n' ;;
                updating) printf 'Updating %s (%s)...\n' "$@" ;;
                pinned_skip) printf '%s: pinned to %s, skipping\n' "$@" ;;
                module_not_found_lockfile) printf '%s: module "%s" not found in the lockfile\n' "$@" ;;
                pin_usage) printf '%s: pin needs a version\n' "$@" ;;
                pin_usage_full) printf 'Usage: %s pin <version>\n' "$@" ;;
                pinned_version) printf '%s: version "%s" registered in the lockfile\n' "$@" ;;
                self_update_no_version) printf '%s: no version specified and none in the lockfile\n' "$@" ;;
                self_update_usage) printf 'Usage: %s self-update <version>\n' "$@" ;;
                download_failed) printf '%s: failed to download version "%s"\n' "$@" ;;
                curl_wget_required) printf '%s: curl or wget required for self-update\n' "$@" ;;
                updated_to_version) printf '%s: updated to version "%s"\n' "$@" ;;
                replace_failed) printf '%s: failed to replace script\n' "$@" ;;
                unknown_cmd) printf '%s: unknown command "%s"\n' "$@" ;;
                run_help) printf 'Run "%s help" to see available commands.\n' "$@" ;;
                module_required) printf '%s: module "%s" required. Run "%s install"\n' "$@" ;;
                local_not_dir) printf '%s: path "%s" is not a directory\n' "$@" ;;
                local_no_module) printf '%s: directory "%s" does not contain a "module" executable\n' "$@" ;;
                local_registered) printf '%s: local module registered\n' "$@" ;;
                local_verified) printf '%s: local module verified\n' "$@" ;;
                local_not_found) printf '%s: local module not found at %s\n' "$@" ;;
                local_skip) printf '%s: local module, skipping\n' "$@" ;;
                alias_added) printf '%s: alias "%s" -> "%s" added\n' "$@" ;;
                alias_skip_install) printf '%s: alias "%s" -> "%s" (skipping clone)\n' "$@" ;;
                remove_has_aliases) printf '%s: module "%s" has aliases:%s. Remove them first.\n' "$@" ;;
                alias_removed) printf '%s: alias "%s" removed\n' "$@" ;;
                rebuild_desc) printf '  rebuild <name>         Rebuilds a module by removing and re-installing it\n' ;;
                rebuilding) printf 'Rebuilding %s...\n' "$@" ;;
                rebuild_done) printf '%s: module "%s" rebuilt\n' "$@" ;;
                reinstalling_diverged) printf '%s: HEAD diverged from lockfile (%s), re-checking out...\n' "$@" ;;
                docs_desc) printf '  docs <list|search> [--limit N] [--module M]  Discovers and greps markdown docs\n' ;;
                docs_no_module_docs) printf '%s: module "%s" has no Markdown files\n' "$@" ;;
                docs_no_sources) printf '%s: no Markdown files found in project or modules\n' "$@" ;;
                docs_truncated) printf '\n... (showing first %s results; use --limit 0 for all)\n' "$@" ;;
                docs_search_needs_term) printf '%s: docs search requires a search term\n' "$@" ;;
                docs_usage) printf 'Usage: %s docs <list|search term> [--limit N] [--module M]\n' "$@" ;;
                module_no_desc) printf '  %-18s Run "%s %s --help" for how to use or "%s docs list --module %s" for Markdown docs.\n' "$@" ;;
            esac
            ;;
        pt|*)
            case "$key" in
                git_not_found) printf '%s: git não encontrado. Instale o git para continuar.\n' "$@" ;;
                initialized) printf '%s: inicializado %s/\n' "$@" ;;
                version_mismatch) printf '%s: versão "%s" requerida, rodando "%s"\n' "$@" ;;
                run_self_update) printf 'Execute "%s self-update" para atualizar.\n' "$@" ;;
                usage) printf 'Uso: %s <comando> [argumentos...]\n\n' "$@" ;;
                internal_cmds) printf 'Comandos internos:\n' ;;
                help_desc) printf '  help                  Exibe esta ajuda\n' ;;
                require_desc) printf '  require <url>[@ref]   Adiciona um módulo ao lockfile e instala\n' ;;
                install_desc) printf '  install               Instala os módulos do lockfile\n' ;;
                update_desc) printf '  update [nome]         Atualiza módulos com constraint de branch\n' ;;
                pin_desc) printf '  pin <versão>         Registra a versão requerida no lockfile\n' ;;
                self_update_desc) printf '  self-update [versão] Atualiza o próprio %s\n' "$@" ;;
                remove_desc) printf '  remove <nome>          Remove um módulo do lockfile e desinstala\n' ;;
                removed_module) printf '%s: módulo "%s" removido\n' "$@" ;;
                not_installed) printf '%s: módulo "%s" não está instalado\n' "$@" ;;
                project_cmds) printf 'Comandos do projeto:\n' ;;
                modules) printf 'Módulos:\n' ;;
                require_usage) printf '%s: require requer uma URL git ou caminho local\nUso: %s require [--local] <url>[@ref] | <caminho>\n' "$@" ;;
                require_no_arg) printf '%s: require requer uma URL git ou caminho local\n' "$@" ;;
                already_installed_same) printf '%s: já instalado com a mesma constraint, nada a fazer\n' "$@" ;;
                updating_constraint) printf '%s: atualizando constraint %s → %s\n' "$@" ;;
                installing) printf 'Instalando %s...\n' "$@" ;;
                install_done) printf 'Pronto. Execute "%s %s" para usá-lo.\n' "$@" ;;
                no_lockfile) printf 'Nenhum lockfile encontrado. Use "%s require <url>" para adicionar módulos.\n' "$@" ;;
                already_installed_skip) printf '%s: já instalado, pulando\n' "$@" ;;
                no_modules_lockfile) printf 'Nenhum módulo no lockfile.\n' ;;
                updating) printf 'Atualizando %s (%s)...\n' "$@" ;;
                pinned_skip) printf '%s: fixado em %s, pulando\n' "$@" ;;
                module_not_found_lockfile) printf '%s: módulo "%s" não encontrado no lockfile\n' "$@" ;;
                pin_usage) printf '%s: pin requer uma versão\n' "$@" ;;
                pin_usage_full) printf 'Uso: %s pin <versão>\n' "$@" ;;
                pinned_version) printf '%s: versão "%s" registrada no lockfile\n' "$@" ;;
                self_update_no_version) printf '%s: nenhuma versão especificada e nenhuma no lockfile\n' "$@" ;;
                self_update_usage) printf 'Uso: %s self-update <versão>\n' "$@" ;;
                download_failed) printf '%s: falha ao baixar versão "%s"\n' "$@" ;;
                curl_wget_required) printf '%s: curl ou wget necessário para self-update\n' "$@" ;;
                updated_to_version) printf '%s: atualizado para versão "%s"\n' "$@" ;;
                replace_failed) printf '%s: falha ao substituir o script\n' "$@" ;;
                unknown_cmd) printf '%s: comando desconhecido "%s"\n' "$@" ;;
                run_help) printf 'Execute "%s help" para ver osss comandos disponíveis.\n' "$@" ;;
                module_required) printf '%s: módulo "%s" necessário. Execute "%s install"\n' "$@" ;;
                local_not_dir) printf '%s: caminho "%s" não é um diretório\n' "$@" ;;
                local_no_module) printf '%s: diretório "%s" não contém um executável "module"\n' "$@" ;;
                local_registered) printf '%s: módulo local registrado\n' "$@" ;;
                local_verified) printf '%s: módulo local verificado\n' "$@" ;;
                local_not_found) printf '%s: módulo local não encontrado em %s\n' "$@" ;;
                local_skip) printf '%s: módulo local, pulando\n' "$@" ;;
                alias_added) printf '%s: alias "%s" -> "%s" adicionado\n' "$@" ;;
                alias_skip_install) printf '%s: alias "%s" -> "%s" (pulando clone)\n' "$@" ;;
                remove_has_aliases) printf '%s: módulo "%s" possui aliases:%s. Remova-os primeiro.\n' "$@" ;;
                alias_removed) printf '%s: alias "%s" removido\n' "$@" ;;
                rebuild_desc) printf '  rebuild <nome>         Reconstrói um módulo removendo e re-instalando\n' ;;
                rebuilding) printf 'Reconstruindo %s...\n' "$@" ;;
                rebuild_done) printf '%s: módulo "%s" reconstruído\n' "$@" ;;
                reinstalling_diverged) printf '%s: HEAD divergiu do lockfile (%s), re-checkout...\n' "$@" ;;
                docs_desc) printf '  docs <list|search> [--limit N] [--module M]  Busca e lista docs markdown\n' ;;
                docs_no_module_docs) printf '%s: módulo "%s" não possui arquivos Markdown\n' "$@" ;;
                docs_no_sources) printf '%s: nenhum arquivo Markdown encontrado no projeto ou módulos\n' "$@" ;;
                docs_truncated) printf '\n... (mostrando primeiros %s resultados; use --limit 0 para todos)\n' "$@" ;;
                docs_search_needs_term) printf '%s: docs search requer um termo de busca\n' "$@" ;;
                docs_usage) printf 'Uso: %s docs <list|search termo> [--limit N] [--module M]\n' "$@" ;;
                module_no_desc) printf '  %-18s Execute "%s %s --help" para usar ou "%s docs list --module %s" para docs Markdown.\n' "$@" ;;
            esac
            ;;
    esac
}

_load_env() {
    if [ -f "$SSS_ENV" ]; then
        case "$SSS_ENV" in
            /*|./*) . "$SSS_ENV" ;;
            *) . "./$SSS_ENV" ;;
        esac
    fi
}

# Remove 'v' inicial para comparação tolerante
_normalize_version() {
    printf '%s\n' "$1" | sed 's/^v//'
}

# Auto-inicializa .sss/ se essstiver em um repositório git
_init() {
    _cmd="$1"
    [ -d ".git" ] || return 0
    if ! command -v git >/dev/null 2>&1; then
        _t git_not_found "$SELF" >&2
        exit 1
    fi
    if [ ! -d "$SSS_DIR" ]; then
        mkdir -p "$SSS_MODULES"
        touch "$SSS_CONFIG"
        _t initialized "$SELF" "$SSS_DIR" >&2
    fi
    if [ -f ".gitignore" ] && ! grep -qx ".sss/modules/\*" .gitignore 2>/dev/null; then
        printf '\n.sss/modules/*\n' >> .gitignore
    fi

    # Verifica versão requerida no lockfile (pula durante self-update)
    [ "$_cmd" = "self-update" ] || [ "$_cmd" = "pin" ] && return 0
    if [ -f "$SSS_LOCKFILE" ]; then
        _required_raw="$(grep "^sss " "$SSS_LOCKFILE" 2>/dev/null | awk '{print $2}')"
        _required="$(_normalize_version "$_required_raw")"
        _current="$(_normalize_version "$SSS_VERSION")"
        if [ -n "$_required" ] && [ "$_required" != "$_current" ]; then
            _t version_mismatch "$SELF" "$_required_raw" "$SSS_VERSION" >&2
            _t run_self_update "$SELF" >&2
            exit 1
        fi
    fi
}

_module_description() {
    _mod_exe="$1"
    if [ ! -f "$_mod_exe" ]; then
        return 1
    fi
    # Lê apenas a segunda linha; só retorna se for um comentário
    _line2=$(sed -n '2p' "$_mod_exe")
    case "$_line2" in
        '# '*)
            printf '%s\n' "${_line2#\# }"
            ;;
        *)
            return 1
            ;;
    esac
}

_help() {
    _t usage "$SELF"
    _t internal_cmds
    _t help_desc
    _t require_desc
    _t install_desc
    _t update_desc
    _t pin_desc
    _t rebuild_desc
    _t remove_desc
    _t self_update_desc "$SELF"
    _t docs_desc

    if [ -f "$SSS_CONFIG" ]; then
        cmds=$(grep -E '^cmd_[a-zA-Z0-9_]+ *\(\)' "$SSS_CONFIG" | sed 's/^cmd_\([a-zA-Z0-9_]*\).*/\1/')
        if [ -n "$cmds" ]; then
            printf '\n'
            _t project_cmds
            printf '%s\n' "$cmds" | while IFS= read -r cmd; do
                [ -n "$cmd" ] || continue
                display="$(printf '%s' "$cmd" | tr '_' ' ')"
                desc=$(grep -B1 "^cmd_${cmd} *()" "$SSS_CONFIG" | grep '^#' | sed 's/^# *//' | tail -1)
                if [ -n "$desc" ]; then
                    printf '  %-18s %s\n' "$display" "$desc"
                else
                    printf '  %s\n' "$display"
                fi
            done
        fi
    fi

    if [ -d "$SSS_MODULES" ]; then
        mods=
        for d in "$SSS_MODULES"/*/; do
            [ -d "$d" ] && mods="${mods}$(basename "$d")\n"
        done
        if [ -n "$mods" ]; then
            printf '\n'
            _t modules
            printf "$mods" | while IFS= read -r mod; do
                [ -n "$mod" ] || continue
                _mod_exe="$SSS_MODULES/$mod/module"
                _mod_desc="$(_module_description "$_mod_exe" 2>/dev/null || true)"
                if [ -n "$_mod_desc" ]; then
                    printf '  %-18s %s\n' "$mod" "$_mod_desc"
                else
                    _t module_no_desc "$mod" "$SELF" "$mod" "$SELF" "$mod"
                fi
            done
        fi
    fi
}

# Atualiza ou adiciona uma entrada de módulo no lockfile (4 campos)
_lockfile_set() {
    lf_name="$1" lf_url="$2" lf_constraint="$3" lf_resolved="$4"
    tmp="$(mktemp)"
    grep -v "^$lf_name " "$SSS_LOCKFILE" > "$tmp" 2>/dev/null || true
    printf '%s %s %s %s\n' "$lf_name" "$lf_url" "$lf_constraint" "$lf_resolved" >> "$tmp"
    mv "$tmp" "$SSS_LOCKFILE"
}

# Atualiza ou adiciona a entrada de versão do próprio sss no lockfile (2 campos)
_lockfile_set_version() {
    _version="$1"
    tmp="$(mktemp)"
    printf 'sss %s\n' "$_version" > "$tmp"
    grep -v "^sss " "$SSS_LOCKFILE" >> "$tmp" 2>/dev/null || true
    mv "$tmp" "$SSS_LOCKFILE"
}

# Detecta o tipo de uma ref em um repositório local: branch, tag ou commit
_detect_ref_type() {
    _repo="$1" _ref="$2"
    if git -C "$_repo" rev-parse --verify "refs/heads/$_ref" >/dev/null 2>&1; then
        _ref_type="branch"
    elif git -C "$_repo" rev-parse --verify "refs/tags/$_ref" >/dev/null 2>&1; then
        _ref_type="tag"
    else
        _ref_type="commit"
    fi
}

# Parssseia "<url>[@ref]" nos componentesss _req_url e _req_ref
_parse_require_arg() {
    _input="$1"
    case "$_input" in
        *@*:*)
            # SSH: git@host:path[@ref] — procura @ apenasss na parte do path
            _path_part="${_input#*:}"
            case "$_path_part" in
                *@*)
                    _req_ref="${_path_part##*@}"
                    _req_url="${_input%@"$_req_ref"}"
                    ;;
                *)
                    _req_url="$_input"
                    _req_ref=""
                    ;;
            esac
            ;;
        *://*)
            # HTTPS/HTTP: procura @ no path (após o hosst)
            _no_scheme="${_input#*://}"
            _path_part="${_no_scheme#*/}"
            case "$_path_part" in
                *@*)
                    _req_ref="${_input##*@}"
                    _req_url="${_input%@"$_req_ref"}"
                    ;;
                *)
                    _req_url="$_input"
                    _req_ref=""
                    ;;
            esac
            ;;
        *)
            # Path local ou outro formato
            case "$_input" in
                *@*)
                    _req_ref="${_input##*@}"
                    _req_url="${_input%@"$_req_ref"}"
                    ;;
                *)
                    _req_url="$_input"
                    _req_ref=""
                    ;;
            esac
            ;;
    esac
}

_add_local_module() {
    path="$1"
    name="$(basename "$path" .git)"

    if [ ! -d "$path" ]; then
        _t local_not_dir "$SELF" "$path" >&2
        exit 1
    fi

    if [ ! -f "$path/module" ] && [ ! -x "$path/module" ]; then
        _t local_no_module "$SELF" "$path" >&2
        exit 1
    fi

    if [ -f "$path/module" ] && [ ! -x "$path/module" ]; then
        chmod +x "$path/module"
    fi

    case "$path" in
        "$SSS_MODULES/"*|".sss/modules/"*)
            if [ -f ".gitignore" ]; then
                if ! grep -qx "!.sss/modules/$name/" .gitignore 2>/dev/null; then
                    printf '!.sss/modules/%s/\n' "$name" >> .gitignore
                fi
            fi
            ;;
    esac

    _lockfile_set "$name" "$path" "local" "-"
    _t local_registered "$name"
}

_require() {
    if [ "$1" = "--local" ]; then
        shift
        if [ -z "$1" ]; then
            _t require_usage "$SELF" "$SELF" >&2
            exit 1
        fi
        _add_local_module "$1"
        return $?
    fi

    if [ -z "$1" ]; then
        _t require_usage "$SELF" "$SELF" >&2
        exit 1
    fi

    _parse_require_arg "$1"
    url="$_req_url"
    ref="$_req_ref"
    name="$(basename "$url" .git)"
    aliases=""
    
    # Support aliasing: require <url> as <canonical>,<alias1>,<alias2>,...
    if [ "${2:-}" = "as" ] && [ -n "${3:-}" ]; then
        names="$3"
        # Extract canonical (first name before comma)
        case "$names" in
            *,*)
                name="${names%%,*}"
                aliases="${names#*,}"
                ;;
            *)
                name="$names"
                ;;
        esac
    fi
    
    target="$SSS_MODULES/$name"

    if [ -d "$target" ]; then
        # Módulo já está instalado - verificar se a constraint mudou
        if [ -n "$ref" ]; then
            git -C "$target" fetch -q --tags
            _detect_ref_type "$target" "$ref"
            ctype="$_ref_type"
        else
            ref="$(git -C "$target" rev-parse --abbrev-ref HEAD)"
            ctype="branch"
        fi
        new_constraint="${ctype}:${ref}"
        existing_constraint="$(grep "^$name " "$SSS_LOCKFILE" 2>/dev/null | awk '{print $3}')"
        if [ "$new_constraint" = "$existing_constraint" ]; then
            _t already_installed_same "$name"
        else
            _t updating_constraint "$name" "$existing_constraint" "$new_constraint"
            if ! git -C "$target" checkout -q "$ref"; then
                printf '%s: failed to checkout "%s"\n' "$SELF" "$ref" >&2
                exit 1
            fi
            resolved="$(git -C "$target" rev-parse HEAD)"
            _lockfile_set "$name" "$url" "$new_constraint" "$resolved"
            _t install_done "$SELF" "$name"
        fi
        
        # Adiciona aliases se houver (idempotente: sobrescreve se existir)
        if [ -n "$aliases" ]; then
            _add_aliases "$name" "$url" "$aliases"
        fi
        return 0
    fi

    _t installing "$name"
    git clone -q "$url" "$target"

    if [ -n "$ref" ]; then
        _detect_ref_type "$target" "$ref"
        ctype="$_ref_type"
        git -C "$target" checkout -q "$ref"
    else
        ref="$(git -C "$target" rev-parse --abbrev-ref HEAD)"
        ctype="branch"
    fi

    resolved="$(git -C "$target" rev-parse HEAD)"
    _lockfile_set "$name" "$url" "${ctype}:${ref}" "$resolved"
    _t install_done "$SELF" "$name"
    
    # Adiciona aliases se houver
    if [ -n "$aliases" ]; then
        _add_aliases "$name" "$url" "$aliases"
    fi
}

# Adiciona entradas de alias no lockfile para um módulo canonical
_add_aliases() {
    _canonical="$1"
    _url="$2"
    _alias_list="$3"
    
    while [ -n "$_alias_list" ]; do
        case "$_alias_list" in
            *,*)
                _alias="${_alias_list%%,*}"
                _alias_list="${_alias_list#*,}"
                ;;
            *)
                _alias="$_alias_list"
                _alias_list=""
                ;;
        esac
        [ -n "$_alias" ] || continue
        _lockfile_set "$_alias" "$_url" "alias:${_canonical}:${_alias}" "-"
        _t alias_added "$_alias" "$_canonical"
    done
}

_install() {
    if [ ! -f "$SSS_LOCKFILE" ]; then
        _t no_lockfile "$SELF"
        return 0
    fi

    count=0
    while IFS=' ' read -r mod_name mod_url mod_constraint mod_resolved; do
        case "$mod_name" in ''|\#*|sss) continue ;; esac
        target="$SSS_MODULES/$mod_name"
        ctype="${mod_constraint%%:*}"
        ref="${mod_constraint#*:}"
        case "$ctype" in
            local)
                if [ ! -d "$mod_url" ]; then
                    _t local_not_found "$mod_name" "$mod_url" >&2
                    exit 1
                fi
                _t local_verified "$mod_name"
                ;;
            alias)
                # Alias: verifica se o módulo canonical existe
                _canonical_name="${mod_constraint#alias:}"
                _canonical_name="${_canonical_name%%:*}"
                _canonical_target="$SSS_MODULES/$_canonical_name"
                if [ ! -d "$_canonical_target" ]; then
                    _t module_required "$SELF" "$_canonical_name" "$SELF" >&2
                    exit 1
                fi
                _t alias_skip_install "$mod_name" "$_canonical_name"
                ;;
            *)
                if [ -d "$target" ]; then
                    _current_head="$(git -C "$target" rev-parse HEAD 2>/dev/null || true)"
                    if [ -n "$mod_resolved" ] && [ "$mod_resolved" != "-" ] && [ "$_current_head" != "$mod_resolved" ]; then
                        _t reinstalling_diverged "$mod_name" "$mod_resolved"
                        git -C "$target" fetch -q origin
                        git -C "$target" reset --hard "origin/$ref"
                        _new_resolved="$(git -C "$target" rev-parse HEAD)"
                        _lockfile_set "$mod_name" "$mod_url" "$mod_constraint" "$_new_resolved"
                    else
                        _t already_installed_skip "$mod_name"
                    fi
                else
                    _t installing "$mod_name"
                    git clone -q "$mod_url" "$target"
                    git -C "$target" checkout -q "$ref"
                fi
                ;;
        esac
        count=$((count + 1))
    done < "$SSS_LOCKFILE"

    if [ "$count" -eq 0 ]; then
        _t no_modules_lockfile
    fi
}

_update() {
    name_filter="$1"

    if [ ! -f "$SSS_LOCKFILE" ]; then
        _t no_lockfile
        return 0
    fi

    updated=0
    skipped=0
    while IFS=' ' read -r mod_name mod_url mod_constraint mod_resolved; do
        case "$mod_name" in ''|\#*|sss) continue ;; esac
        [ -n "$name_filter" ] && [ "$mod_name" != "$name_filter" ] && continue

        target="$SSS_MODULES/$mod_name"
        ctype="${mod_constraint%%:*}"
        ref="${mod_constraint#*:}"

        case "$ctype" in
            branch)
                _t updating "$mod_name" "$ref"
                git -C "$target" fetch -q origin
                git -C "$target" reset --hard "origin/$ref"
                new_resolved="$(git -C "$target" rev-parse HEAD)"
                _lockfile_set "$mod_name" "$mod_url" "$mod_constraint" "$new_resolved"
                updated=$((updated + 1))
                ;;
            local)
                _t local_skip "$mod_name"
                skipped=$((skipped + 1))
                ;;
            tag|commit)
                _t pinned_skip "$mod_name" "$mod_constraint"
                skipped=$((skipped + 1))
                ;;
        esac
    done < "$SSS_LOCKFILE"

    if [ -n "$name_filter" ] && [ "$updated" -eq 0 ] && [ "$skipped" -eq 0 ]; then
        _t module_not_found_lockfile "$SELF" "$name_filter" >&2
        exit 1
    elif [ -z "$name_filter" ] && [ "$updated" -eq 0 ] && [ "$skipped" -eq 0 ]; then
        _t no_modules_lockfile
    fi
}

_pin() {
    version="${1:-}"
    if [ -z "$version" ]; then
        _t pin_usage "$SELF" >&2
        _t pin_usage_full "$SELF" >&2
        exit 1
    fi
    version="$(_normalize_version "$version")"
    _lockfile_set_version "$version"
    _t pinned_version "$SELF" "$version"
}

_self_update() {
    version="${1:-}"

    if [ -z "$version" ]; then
        # Usa versão do lockfile
        version="$(grep "^sss " "$SSS_LOCKFILE" 2>/dev/null | awk '{print $2}')"
        if [ -z "$version" ]; then
            _t self_update_no_version "$SELF" >&2
            _t self_update_usage "$SELF" >&2
            exit 1
        fi
    fi

    version_norm="$(_normalize_version "$version")"
    version_with_v="v${version_norm}"
    version_without_v="${version_norm}"

    tmp="$(mktemp "$(dirname "$0")/.sss_tmp.XXXXXX")"
    downloaded=0

    _try_download() {
        _url="https://gitea.abbluiz.com/snake-ink/sss/raw/${1}/sss"
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL "$_url" -o "$tmp" 2>/dev/null && return 0
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "$tmp" "$_url" 2>/dev/null && return 0
        fi
        return 1
    }

    if _try_download "$version_with_v"; then
        downloaded=1
    elif _try_download "$version_without_v"; then
        downloaded=1
    fi

    if [ "$downloaded" -eq 0 ]; then
        _t download_failed "$SELF" "$version" >&2
        rm -f "$tmp"
        exit 1
    fi

    chmod +x "$tmp"
    if ! mv "$tmp" "$0"; then
        rm -f "$tmp"
        _t replace_failed "$SELF" >&2
        exit 1
    fi
    _t updated_to_version "$SELF" "$version_norm"
    _lockfile_set_version "$version_norm"
}

_remove() {
    name="$1"
    if [ -z "$name" ]; then
        printf '%s: remove needs a module name\n' "$SELF" >&2
        exit 1
    fi

    if [ ! -f "$SSS_LOCKFILE" ]; then
        _t not_installed "$SELF" "$name" >&2
        exit 1
    fi

    # Check if module is in lockfile
    entry="$(grep "^$name " "$SSS_LOCKFILE" 2>/dev/null)"
    if [ -z "$entry" ]; then
        _t not_installed "$SELF" "$name" >&2
        exit 1
    fi

    ctype="$(echo "$entry" | awk '{print $3}')"

    # Se for alias, remove apenas a entrada do lockfile
    case "$ctype" in
        alias:*)
            tmp="$(mktemp)"
            grep -v "^$name " "$SSS_LOCKFILE" > "$tmp" 2>/dev/null || true
            mv "$tmp" "$SSS_LOCKFILE"
            _t alias_removed "$SELF" "$name"
            return 0
            ;;
    esac

    # Se for canonical, verifica se há aliases apontando para ele
    alias_list=""
    while IFS=' ' read -r _mod_name _mod_url _mod_constraint _mod_resolved; do
        case "$_mod_name" in ''|\#*|sss) continue ;; esac
        case "$_mod_constraint" in
            alias:$name:*)
                alias_list="$alias_list $_mod_name"
                ;;
        esac
    done < "$SSS_LOCKFILE"

    if [ -n "$alias_list" ]; then
        _t remove_has_aliases "$SELF" "$name" "$alias_list" >&2
        exit 1
    fi

    target="$SSS_MODULES/$name"
    # Only remove directory for non-local modules
    if [ "$ctype" != "local" ] && [ -d "$target" ]; then
        rm -rf "$target"
    fi

    # Remove from lockfile
    tmp="$(mktemp)"
    grep -v "^$name " "$SSS_LOCKFILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$SSS_LOCKFILE"

    # Update .gitignore if needed
    if [ -f ".gitignore" ]; then
        tmp="$(mktemp)"
        grep -vx "!.sss/modules/$name/" ".gitignore" > "$tmp" 2>/dev/null || true
        mv "$tmp" ".gitignore"
    fi

    _t removed_module "$SELF" "$name"
}

_rebuild() {
    name="$1"
    if [ -z "$name" ]; then
        printf '%s: rebuild needs a module name\n' "$SELF" >&2
        exit 1
    fi

    if [ ! -f "$SSS_LOCKFILE" ]; then
        _t not_installed "$SELF" "$name" >&2
        exit 1
    fi

    # Check if module is in lockfile
    entry="$(grep "^$name " "$SSS_LOCKFILE" 2>/dev/null)"
    if [ -z "$entry" ]; then
        _t not_installed "$SELF" "$name" >&2
        exit 1
    fi

    ctype="$(echo "$entry" | awk '{print $3}')"
    url="$(echo "$entry" | awk '{print $2}')"
    mod_resolved="$(echo "$entry" | awk '{print $4}')"

    # Se for alias, erro com hint
    case "$ctype" in
        alias:*)
            canonical="${ctype#alias:}"
            canonical="${canonical%%:*}"
            printf '%s: "%s" is an alias. Rebuild the canonical module instead: %s rebuild %s\n' "$SELF" "$name" "$SELF" "$canonical" >&2
            exit 1
            ;;
    esac

    # Se for local, não faz sentido rebuild
    if [ "$ctype" = "local" ]; then
        printf '%s: cannot rebuild local module "%s"\n' "$SELF" "$name" >&2
        exit 1
    fi

    target="$SSS_MODULES/$name"

    _t rebuilding "$name"

    # Remove o diretório do módulo
    if [ -d "$target" ]; then
        rm -rf "$target"
    fi

    # Re-clona e re-instala
    git clone -q "$url" "$target"

    ref="${ctype#*:}"
    git -C "$target" checkout -q "$ref"

    new_resolved="$(git -C "$target" rev-parse HEAD)"
    _lockfile_set "$name" "$url" "$ctype" "$new_resolved"

    _t rebuild_done "$SELF" "$name"
}

# --- Docs ---

_docs_sources() {
    # Lista diretórios de docs e roots: projeto + módulos
    printf '%s\n' "."  # project root
    [ -d "docs" ] && printf '%s\n' "docs"
    if [ -d "$SSS_MODULES" ]; then
        for _mod in "$SSS_MODULES"/*; do
            if [ -d "$_mod" ]; then
                printf '%s\n' "$_mod"  # module root
                [ -d "$_mod/docs" ] && printf '%s\n' "$_mod/docs"
            fi
        done
    fi
}

_docs() {
    _limit=100
    _module=""
    _subcmd=""
    _term=""

    # Parse args
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit|-l)
                shift
                _limit="${1:-100}"
                shift
                ;;
            --module|-m)
                shift
                _module="${1:-}"
                shift
                ;;
            *)
                if [ -z "$_subcmd" ]; then
                    _subcmd="$1"
                elif [ -z "$_term" ]; then
                    _term="$1"
                fi
                shift
                ;;
        esac
    done

    # Valida subcmd antes de checar fontes
    case "$_subcmd" in
        list|search)
            if [ "$_subcmd" = "search" ] && [ -z "$_term" ]; then
                _t docs_search_needs_term "$SELF" >&2
                exit 1
            fi
            ;;
        *)
            _t docs_usage "$SELF" >&2
            exit 1
            ;;
    esac

    # Determina fontes
    if [ -n "$_module" ]; then
        _mod_root="$SSS_MODULES/$_module"
        if [ ! -d "$_mod_root" ]; then
            _t docs_no_module_docs "$SELF" "$_module" >&2
            exit 1
        fi
        _sources="$(
            printf '%s\n' "$_mod_root"
            [ -d "$_mod_root/docs" ] && printf '%s\n' "$_mod_root/docs"
        )"
    else
        _sources="$(_docs_sources)"
    fi

    # Build list of markdown files from sources
    _tmpfile="$(mktemp)"
    printf '%s\n' "$_sources" | while IFS= read -r _src; do
        case "$_src" in
            docs|*/docs)
                find "$_src" -type f -name '*.md' -print
                ;;
            *)
                for _f in "$_src"/*.md; do
                    [ -f "$_f" ] && printf '%s\n' "$_f"
                done
                ;;
        esac
    done | sort > "$_tmpfile"

    if [ ! -s "$_tmpfile" ]; then
        _t docs_no_sources "$SELF" >&2
        rm -f "$_tmpfile"
        exit 1
    fi

    _outfile="$(mktemp)"
    case "$_subcmd" in
        list)
            cat "$_tmpfile" > "$_outfile"
            ;;
        search)
            if command -v rg >/dev/null 2>&1; then
                while IFS= read -r _f; do
                    [ -n "$_f" ] && rg -H -n "$_term" "$_f" 2>/dev/null
                done < "$_tmpfile" > "$_outfile"
            else
                while IFS= read -r _f; do
                    [ -n "$_f" ] && grep -H -n "$_term" "$_f" 2>/dev/null
                done < "$_tmpfile" > "$_outfile"
            fi
            ;;
        *)
            _t docs_usage "$SELF" >&2
            rm -f "$_tmpfile" "$_outfile"
            exit 1
            ;;
    esac

    _count="$(wc -l < "$_outfile" | tr -d ' ')"
    case "$_limit" in
        0) cat "$_outfile" ;;
        ''|*[!0-9]*) head -n 100 "$_outfile" ;;
        *)
            if [ "$_count" -gt "$_limit" ]; then
                head -n "$_limit" "$_outfile"
                _t docs_truncated "$_limit"
            else
                cat "$_outfile"
            fi
            ;;
    esac
    rm -f "$_tmpfile" "$_outfile"
}

# --- Principal ---

CMD="${1:-help}"
[ $# -gt 0 ] && shift

_init "$CMD"

# Carrega .env cedo para permitir override de SSS_* antes do dispatch
_load_env
SSS_LANG="${SSS_LANG:-pt}"
# Se .env redefiniu SSS_ENV para outro arquivo, carrega também
if [ -n "$SSS_ENV" ] && [ "$SSS_ENV" != ".env" ]; then
    _load_env
fi

case "$CMD" in
    help|--help|-h)
        _help
        ;;
    require)
        _require "$@"
        ;;
    install)
        _install "$@"
        ;;
    update)
        _update "$@"
        ;;
    pin)
        _pin "$@"
        ;;
    remove)
        _remove "$@"
        ;;
    rebuild)
        _rebuild "$@"
        ;;
    docs)
        _docs "$@"
        ;;
    self-update)
        _self_update "$@"
        ;;
    *)
        # Tenta um comando do projeto no config
        if [ -f "$SSS_CONFIG" ]; then
            # Verifica se osss módulossss requeridosss estão inssstalados
            requires() {
                for _req_mod in "$@"; do
                    _mod_found=0
                    if [ -d "$SSS_MODULES/$_req_mod" ]; then
                        _mod_found=1
                    elif [ -f "$SSS_LOCKFILE" ]; then
                        _local_path="$(grep "^$_req_mod " "$SSS_LOCKFILE" 2>/dev/null | awk '$3 == "local" {print $2}')"
                        if [ -n "$_local_path" ] && [ -d "$_local_path" ]; then
                            _mod_found=1
                        fi
                    fi
                    if [ "$_mod_found" -eq 0 ]; then
                        _t module_required "$SELF" "$_req_mod" "$SELF" >&2
                        exit 1
                    fi
                done
            }
            . "$SSS_CONFIG"
            # Constrói candidato completo (CMD + todos osss args)
            _cand="$CMD"
            _n=0
            for _a in "$@"; do
                _cand="${_cand}_${_a}"
                _n=$((_n + 1))
            done

            # Reduz da direita até encontrar um comando (longest-match)
            while true; do
                command -v "cmd_${_cand}" >/dev/null 2>&1 && break
                [ "$_cand" = "$CMD" ] && break
                _cand="${_cand%_*}"
                _n=$((_n - 1))
            done

            if command -v "cmd_${_cand}" >/dev/null 2>&1; then
                shift $_n
                "cmd_${_cand}" "$@"
                exit $?
            fi
        fi

        # Verifica se é um alias no lockfile antes de tentar módulo direto
        if [ -f "$SSS_LOCKFILE" ]; then
            alias_constraint="$(awk -v n="$CMD" '$1==n {print $3; exit}' "$SSS_LOCKFILE")"
            case "$alias_constraint" in
                alias:*)
                    alias_rest="${alias_constraint#alias:}"
                    canonical="${alias_rest%%:*}"
                    case "$alias_rest" in
                        *:*) prepend_arg="${alias_rest#*:}" ;;
                        *)   prepend_arg="" ;;
                    esac
                    canonical_module="$SSS_MODULES/$canonical/module"
                    if [ -x "$canonical_module" ]; then
                        if [ -n "$prepend_arg" ]; then
                            exec "$canonical_module" "$prepend_arg" "$@"
                        else
                            exec "$canonical_module" "$@"
                        fi
                    fi
                    ;;
            esac
        fi

        # Tenta um módulo
        module="$SSS_MODULES/$CMD/module"
        if [ -x "$module" ]; then
            exec "$module" "$@"
        fi

        # Tenta módulo local do lockfile
        if [ -f "$SSS_LOCKFILE" ]; then
            local_path="$(grep "^$CMD " "$SSS_LOCKFILE" 2>/dev/null | awk '$3 == "local" {print $2}')"
            if [ -n "$local_path" ] && [ -x "$local_path/module" ]; then
                exec "$local_path/module" "$@"
            fi
        fi

        _t unknown_cmd "$SELF" "$CMD" >&2
        _t run_help "$SELF" >&2
        exit 1
        ;;
esac
